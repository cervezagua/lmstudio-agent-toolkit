{
  "name": "lmstudio-agent-toolkit",
  "private": true,
  "description": "An LM Studio plugin that gives local models coding-agent tools: files and shell, memory, git, web and documents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cervezagua/lmstudio-agent-toolkit.git"
  },
  "homepage": "https://github.com/cervezagua/lmstudio-agent-toolkit#readme",
  "bugs": {
    "url": "https://github.com/cervezagua/lmstudio-agent-toolkit/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/install.mjs",
    "deps": "npm --prefix plugin install",
    "test": "vitest run",
    "typecheck": "npm --prefix plugin run typecheck",
    "e2e": "node scripts/e2e.mjs",
    "hub:push": "node scripts/hub-push.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "vitest": "^3.2.4"
  }
}
